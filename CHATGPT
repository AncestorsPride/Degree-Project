from pydub import AudioSegment
from pydub.playback import play
import time

# Path to your MP3 file
audio_path = "path/to/your/audiofile.mp3"

# Load the MP3 file
audio = AudioSegment.from_file(audio_path)

# Calculate the current dBFS and the target dBFS for 10% volume
current_dBFS = audio.dBFS
target_dBFS = -20.0  # -20 dBFS is typically used to represent 10% volume

# Apply the gain to set the volume to 10%
gain_needed = target_dBFS - current_dBFS
audio_at_10_percent = audio.apply_gain(gain_needed)

# Duration to play in milliseconds (e.g., 3 minutes = 180000 milliseconds)
duration = 3 * 60 * 1000
chunk_duration = 1000  # Play in chunks of 1000 milliseconds (1 second)

# Play the audio in chunks to simulate real-time adjustment
start_time = 0
end_time = chunk_duration
while start_time < duration:
    # Extract the chunk
    chunk = audio_at_10_percent[start_time:end_time]
    
    # Play the chunk
    play(chunk)
    
    # Update times for the next chunk
    start_time += chunk_duration
    end_time += chunk_duration
    
    # Small sleep to simulate real-time playback
    time.sleep(0.01)

